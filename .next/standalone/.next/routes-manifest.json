{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=120"
        }
      ],
      "regex": "^/api(?:/(.*))(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/api/admin/orders/[orderId]",
      "regex": "^/api/admin/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPorderId": "nxtPorderId"
      },
      "namedRegex": "^/api/admin/orders/(?<nxtPorderId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/roles/[roleId]",
      "regex": "^/api/admin/roles/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtProleId": "nxtProleId"
      },
      "namedRegex": "^/api/admin/roles/(?<nxtProleId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/users/[userId]",
      "regex": "^/api/admin/users/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPuserId": "nxtPuserId"
      },
      "namedRegex": "^/api/admin/users/(?<nxtPuserId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/products/[ean]",
      "regex": "^/api/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPean": "nxtPean"
      },
      "namedRegex": "^/api/products/(?<nxtPean>[^/]+?)(?:/)?$"
    },
    {
      "page": "/produtos/[ean]",
      "regex": "^/produtos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPean": "nxtPean"
      },
      "namedRegex": "^/produtos/(?<nxtPean>[^/]+?)(?:/)?$"
    }
  ],
